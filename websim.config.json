`````` index.html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WebSim.ai PDF Analysis</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container mt-5">
        <h1 class="text-center mb-4">PDF Analyzer</h1>

        <div id="upload-container" class="text-center">
            <div id="upload-zone" class="border p-5 mb-3">
                <p>Drag & Drop your PDF here or click to browse (Max 50MB)</p>
                <input type="file" id="pdf-upload" accept="application/pdf" hidden>
            </div>
            <div id="file-info" class="text-start" style="display: none;">
                <h5>File Details:</h5>
                <p>Name: <span id="file-name"></span></p>
                <p>Size: <span id="file-size"></span></p>
                <p>Pages: <span id="page-count"></span></p>
            </div>
            <div id="processing-progress" style="display: none;">
                <div class="progress mb-3" role="progressbar" aria-label="Processing progress" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                    <div id="progress-bar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%;">0%</div>
                </div>
                <p>Processing page <span id="current-page">0</span> of <span id="total-pages">0</span>...</p>
                 <p id="status-message" class="text-muted small"></p>
            </div>
        </div>

        <div id="results-container" style="display: none;">
            <h2 class="mt-5">Analysis Results</h2>
             <div class="input-group mb-3">
                <input type="text" id="search-input" class="form-control" placeholder="Search analysis text across all pages...">
                <button class="btn btn-outline-secondary" type="button" id="search-button">Search</button>
                <button class="btn btn-outline-danger" type="button" id="clear-search-button" title="Clear Search Highlights">X</button>
            </div>

             <div id="search-results-summary" class="mb-2 text-muted small" style="display: none;"></div>

            <div class="accordion mb-3" id="tocAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="tocHeading">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseToc" aria-expanded="false" aria-controls="collapseToc">
                        Table of Contents (<span id="toc-count">0</span> pages)
                    </button>
                    </h2>
                    <div id="collapseToc" class="accordion-collapse collapse" aria-labelledby="tocHeading" data-bs-parent="#tocAccordion">
                    <div class="accordion-body p-0">
                         <ul id="toc-list" class="list-group list-group-flush" style="max-height: 200px; overflow-y: auto;">
                            <!-- TOC items will be added here -->
                        </ul>
                    </div>
                    </div>
                </div>
            </div>


            <div class="row">
                <div class="col-md-6">
                    <h5>PDF Page Image (<span id="current-page-display-img">1</span>/<span id="total-pages-display-img">1</span>)</h5>
                    <div id="pdf-viewer" class="border overflow-auto bg-light" style="height: 600px; position: relative; text-align: center;">
                         <img id="page-image" src="" alt="PDF Page" class="img-fluid" style="cursor: zoom-in; background-color: white; box-shadow: 0 0 5px rgba(0,0,0,0.2);">
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap">
                         <div class="btn-group me-2 mb-1">
                            <button id="prev-page" class="btn btn-secondary btn-sm">Previous</button>
                            <button id="next-page" class="btn btn-secondary btn-sm">Next</button>
                        </div>
                         <div class="input-group input-group-sm me-2 mb-1" style="width: 150px;">
                            <input type="number" id="jump-to-page-input" min="1" class="form-control" placeholder="Page #" aria-label="Jump to page number">
                            <button id="jump-to-page-btn" class="btn btn-primary">Go</button>
                        </div>
                         <div class="btn-group mb-1">
                            <button id="zoom-in" class="btn btn-outline-secondary btn-sm" title="Zoom In">+</button>
                            <button id="zoom-out" class="btn btn-outline-secondary btn-sm" title="Zoom Out">-</button>
                            <button id="reset-zoom" class="btn btn-outline-secondary btn-sm" title="Reset Zoom">Reset</button>
                        </div>
                    </div>

                </div>
                <div class="col-md-6">
                    <h5>LLM Analysis</h5>
                    <div id="analysis-output" class="border p-3 overflow-auto bg-white" style="height: 600px;">
                        Upload a PDF to begin analysis.
                    </div>
                     <div class="mt-3 text-end">
                        <div class="btn-group btn-group-sm">
                            <button id="export-page-md" class="btn btn-info" title="Export current page analysis as Markdown">Export Page (MD)</button>
                            <button id="export-all-md" class="btn btn-primary" title="Export all analyses as a single Markdown file">Export All (MD)</button>
                            <button id="download-page-image" class="btn btn-success" title="Download current page image as PNG">Download Image</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Error Modal -->
        <div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="errorModalLabel">Error</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body" id="errorModalBody">
                An unexpected error occurred.
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              </div>
            </div>
          </div>
        </div>

    </div>

    <script type="importmap">
      {
        "imports": {
          "pdfjs-dist": "https://cdn.jsdelivr.net/npm/pdfjs-dist@4.4.168/build/pdf.min.mjs",
          "pdfjs-dist/build/pdf.worker.min.mjs": "https://cdn.jsdelivr.net/npm/pdfjs-dist@4.4.168/build/pdf.worker.min.mjs"
        }
      }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script type="module" src="script.js"></script>
</body>
</html>

{
  "displayName": "PDF Analyzer",
  "description": "Upload a PDF (max 50MB), analyze each page's content and structure using AI image analysis, view interactive results, search text, and export findings.",
  "features": {
    "multiplayer": false,
    "llm": true
  }
}

